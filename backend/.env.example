# Zitadel OIDC — leave unset for anonymous dev mode
# ZITADEL_ISSUER=https://your-org-xyz123.zitadel.cloud
# ZITADEL_CLIENT_ID=1234567890@isigned   # optional audience check
# PORT=4820

# Signing provider seam (Architecture §3.2) — swap without code changes
# HSM_PROVIDER=dev            # dev (Ed25519, local) | securosys
# SECUROSYS_TSB_URL=https://tsb-demo.cloudshsm.com
# SECUROSYS_API_KEY=
# SECUROSYS_KEY_NAME=isigned-signing-key

# PPS (Pay Per Sign) prices in cents — invoiced via Stripe later
# PPS_PRICE_SES=150
# PPS_PRICE_ADES=450
# PPS_PRICE_QES=990

# Stripe (Apple Pay / Google Pay ride on PaymentIntents) — unset = simulated
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
